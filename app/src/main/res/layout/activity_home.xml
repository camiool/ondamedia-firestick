<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Imagen de la película seleccionada, arriba a la derecha -->
    <FrameLayout
        android:layout_width="700dp"
        android:layout_height="394dp"
        android:layout_gravity="top|end">

        <ImageView
            android:id="@+id/hero_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_left" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_bottom" />
    </FrameLayout>

    <!-- Datos de la película seleccionada -->
    <LinearLayout
        android:id="@+id/hero_info"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="58dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/hero_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:maxHeight="84dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#AA000000"
            android:shadowRadius="8" />

        <TextView
            android:id="@+id/hero_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_dim" />

        <TextView
            android:id="@+id/hero_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/text_dim"
            android:maxLines="3"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Marca y accesos, arriba -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="48dp"
        android:layout_marginTop="18dp"
        android:text="ONDAMEDIA"
        android:letterSpacing="0.25"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/accent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginRight="48dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_search"
            style="@style/TvButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="36dp"
            android:textSize="13sp"
            android:text="Buscar" />

        <Button
            android:id="@+id/btn_account"
            style="@style/TvButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="36dp"
            android:layout_marginLeft="10dp"
            android:textSize="13sp"
            android:text="Iniciar sesión" />
    </LinearLayout>

    <!-- Filas de películas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="262dp"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="4dp" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent" />

    <LinearLayout
        android:id="@+id/error_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_retry"
            style="@style/TvButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Reintentar" />
    </LinearLayout>
</FrameLayout>
